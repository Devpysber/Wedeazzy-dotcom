{
  "name": "wedeazzy-platform",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --prefix backend",
    "build": "npm install --prefix backend --omit=dev && node backend/node_modules/prisma/build/index.js generate --schema=backend/prisma/schema.prisma",
    "postinstall": "npm install --prefix backend --omit=dev && node backend/node_modules/prisma/build/index.js generate --schema=backend/prisma/schema.prisma",
    "start": "node backend/src/server.js",
    "seed:admin": "npm run seed:admin --prefix backend",
    "seed:vendors": "npm run seed:vendors --prefix backend",
    "seed:demo": "node backend/src/scripts/seed-demo-credentials.js",
    "install:backend": "npm install --prefix backend",
    "prisma:gen": "npm run prisma:gen --prefix backend",
    "prisma:deploy": "npm run prisma:deploy --prefix backend",
    "prisma:migrate": "npm run prisma:migrate --prefix backend",
    "db:repair": "npm run db:repair --prefix backend",
    "db:repair:force": "npm run db:repair:force --prefix backend",
    "db:check": "npm run db:check --prefix backend",
    "build:zip": "node build-deploy.js"
  },
  "dependencies": {
    "prisma": "5.22.0"
  },
  "devDependencies": {
    "prisma": "5.22.0"
  },
  "prisma": {
    "schema": "backend/prisma/schema.prisma"
  }
}
