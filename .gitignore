# --- Dependencies ---
node_modules/
**/node_modules/

# --- Secrets / environment (NEVER commit) ---
.env
.env.*
**/.env
**/.env.*
# The VPS keeps its production config as backend.env next to the compose file
# (docker compose `env_file:`), which none of the .env globs above match — an
# `git add -A` on the server would otherwise commit every live secret.
backend.env
**/backend.env
# keep the placeholder templates only
!.env.example
!**/.env.example

# --- Runtime / generated ---
**/uploads/
!**/uploads/.gitkeep
**/kyc-private/
!**/kyc-private/.gitkeep
# Staged CSV imports awaiting confirmation. These hold real business contact
# data (names, phone numbers, email addresses) parsed out of an admin's upload
# and must never be committed. Swept automatically after 6 hours.
**/import-staging/
!**/import-staging/.gitkeep
**/baileys-auth/
!**/baileys-auth/.gitkeep
**/logs/
!**/logs/.gitkeep
.data/
**/.data/
*.log

# --- Keys / certs / DB dumps (never commit) ---
*.pem
*.key
*.p12
*.pfx
*.sql
*.sql.gz
*.dump
# ...but Prisma migrations ARE source and must be committed. Without this the
# blanket *.sql above silently swallows them, `migrate deploy` finds nothing to
# apply, and a fresh deploy comes up with an empty database.
!**/prisma/migrations/**/*.sql

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# redundant local deploy-copy artifact (not needed in repo)
/wedeazzy-production-deploy/
/wedeazzy-production-ready.zip
