// WedEazzy backend schema
// Run: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------- ENUMS ----------
enum Role {
  admin
  vendor
  couple
}

enum VendorTier {
  basic
  featured
}

enum InquiryStatus {
  new
  contacted
  quoted
  booked
  closed
  lost
}

enum BookingStatus {
  pending
  confirmed
  cancelled
  completed
}

enum TxnStatus {
  initiated
  success
  failed
  refunded
}

enum AdCampaignStatus {
  draft
  pending_review
  active
  paused
  completed
}

// ---------- CORE ----------
model User {
  id            String    @id @default(cuid())
  phone         String?   @unique                            // E.164: 917498987620
  role          Role
  name          String?
  email         String?   @unique
  passwordHash  String?
  mustChangePassword Boolean @default(false) @map("must_change_password") // set when admin issues login credentials directly
  verifiedAt    DateTime?
  googleId      String?   @unique @map("google_id")
  authProvider  String    @default("local") @map("auth_provider")
  revokedBefore DateTime? @map("revoked_before")
  suspendedAt   DateTime? @map("suspended_at")
  imageUrl      String?   @map("image_url")
  lastLogin     DateTime? @map("last_login")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  vendor            Vendor[]
  couple            Couple?
  sessions          Session[]
  txns              Transaction[]
  waMessages        WaMessage[]   @relation("WaMessagesToUser")
  inquiriesAsCouple Inquiry[]     @relation("CoupleInquiries")

  @@index([role])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique                              // JWT jti
  ip         String?
  userAgent  String?  @db.VarChar(255)
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

// OtpCode: hashed OTPs for WhatsApp phone login (startOtp/verifyOtp), email
// verification (startEmailOtp/verifyEmailOtp) and admin 2FA. The `phone` column
// also stores email addresses for the email/2FA flows (unified store).
// Distinct from UserOtp below — both are in active use.
model OtpCode {
  id         String   @id @default(cuid())
  phone      String                                        // E.164
  codeHash   String                                        // bcrypt of 6-digit code
  purpose    String                                        // "login" | "signup" | etc.
  attempts   Int      @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([phone, createdAt])
}

// ---------- CLAIM BUSINESS ----------

// Every claim OTP request/verification, for rate limiting + audit.
// Keeps us honest about how many attempts a specific IP or vendor got hit with.
model ClaimAttempt {
  id         String   @id @default(cuid())
  vendorId   String                                        // which listing was targeted
  phone      String                                        // masked or full — depends on step
  ip         String?
  ok         Boolean  @default(false)                      // true if OTP verified successfully
  reason     String?                                       // 'sent' | 'wrong_otp' | 'expired' | 'verified' | 'rate_limited'
  createdAt  DateTime @default(now())

  @@index([vendorId, createdAt])
  @@index([ip, createdAt])
}

// Manual review request when the vendor can't access the listed phone number.
// Admin reviews these in the Approve Businesses section.
model ClaimRequest {
  id             String   @id @default(cuid())
  vendorId       String
  claimantName   String
  claimantEmail  String
  claimantPhone  String?
  proofUrl       String?  @db.VarChar(500)                 // link to website/GMB/instagram etc.
  proofNotes     String?  @db.Text
  status         String   @default("pending")              // 'pending' | 'approved' | 'rejected'
  adminNotes     String?  @db.Text
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, createdAt])
  @@index([vendorId])
}

// ---------- VENDORS ----------
model Vendor {
  id                String     @id @default(cuid())
  // Nullable: seeded/unclaimed listings have no owner yet.
  // Claim flow: vendor signs up via OTP -> we set userId.
  userId            String?
  legacyId          String?    @unique                     // matches the static-site vendor `id` (slug) for claim flow
  businessName      String
  slug              String     @unique
  category          String
  categorySlug      String
  city              String
  citySlug          String
  state             String?
  country           String     @default("India")            // ISO country name, e.g. "India", "USA"
  countryCode       String     @default("IN")               // ISO 3166-1 alpha-2
  area              String?
  address           String?    @db.Text
  pincode           String?
  lat               Float?
  lng               Float?
  googleCid         String?
  whatsappNumber    String?                                // optional; ALL inquiries still route to admin first
  description       String?    @db.Text
  priceMin          Int?                                   // INR
  priceMax          Int?
  capacity          Int?                                   // for venues - guest count
  services          Json?                                  // ["catering","stage","sound"] etc.
  alternateMobile   String?
  website           String?
  instagram         String?
  facebook          String?
  youtube           String?
  businessTimings   String?    @db.Text
  yearsExperience   Int?
  teamSize          Int?
  serviceAreas      String?
  languagesSpoken   String?
  acceptsDestination Boolean    @default(false)
  googleBusiness    String?
  kycDocumentUrl    String?                                // proof-of-business document (registration/GST/ID), admin-uploaded
  rating            Float      @default(4.5)
  ratingCount       Int        @default(0)
  tier              VendorTier @default(basic)
  featuredUntil     DateTime?
  subscriptionPlan   String     @default("Free")
  subscriptionStart  DateTime?  @default(now())
  subscriptionExpiry DateTime?
  razorpayOrderId    String?
  isActive          Boolean    @default(true)
  isVerified        Boolean    @default(false)
  isProfileComplete Boolean    @default(false)
  // Claim-invitation outreach tracking (Approve Businesses > Invitations):
  // when an admin last sent this unclaimed listing an invite to claim it,
  // and over which channel. Nullable = never invited.
  invitedAt         DateTime?
  invitedChannel    String?
  countryId         String?    @map("country_id")
  cityId            String?    @map("city_id")
  regionId          String?    @map("region_id")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  user       User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  countryRel Country?          @relation(fields: [countryId], references: [id], onDelete: SetNull)
  cityRel    City?             @relation(fields: [cityId], references: [id], onDelete: SetNull)
  regionRel  Region?           @relation(fields: [regionId], references: [id], onDelete: SetNull)
  photos     VendorPhoto[]
  inquiries  Inquiry[]
  bookings   Booking[]
  campaigns  AdCampaign[]
  lock       PincodeLock?
  reviews    Review[]

  @@index([categorySlug, citySlug])
  @@index([pincode, categorySlug])
  @@index([tier])
  @@index([userId])
  @@index([country, categorySlug])
  @@index([countryId])
  @@index([cityId])
  @@index([regionId])
}

model VendorPhoto {
  id        String   @id @default(cuid())
  vendorId  String
  url       String   @db.VarChar(500)
  width     Int?
  height    Int?
  position  Int      @default(0)
  isCover   Boolean  @default(false)
  createdAt DateTime @default(now())

  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  @@index([vendorId, position])
}

// Hard "one featured per pincode + category" constraint backing the sales pitch.
model PincodeLock {
  pincode      String
  categorySlug String
  vendorId     String   @unique
  lockedUntil  DateTime
  createdAt    DateTime @default(now())

  vendor       Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@id([pincode, categorySlug])
}

// ---------- COUPLES ----------
model Couple {
  id            String   @id @default(cuid())
  userId        String   @unique
  partnerName   String?
  weddingDate   DateTime?
  city          String?
  citySlug      String?
  budgetMin     Int?
  budgetMax     Int?
  guestCount    Int?
  vibe          String?                                    // "destination", "intimate", "grand"...
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planTasks     PlanTask[]
  shortlists    Shortlist[]
  bookings      Booking[]
  guests        Guest[]
}

model Shortlist {
  id        String        @id @default(cuid())
  coupleId  String
  vendorId  String
  status    InquiryStatus @default(new)
  createdAt DateTime      @default(now())

  couple    Couple        @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  @@unique([coupleId, vendorId])
}

model PlanTask {
  id         String   @id @default(cuid())
  coupleId   String
  title      String
  category   String?                                       // "venue","photographer","attire", etc.
  dueDate    DateTime?
  done       Boolean  @default(false)
  remindAt   DateTime?
  remindedAt DateTime?
  createdAt  DateTime @default(now())

  couple     Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  @@index([coupleId, dueDate])
  @@index([remindAt])
}

model Guest {
  id        String   @id @default(cuid())
  coupleId  String
  name      String
  count     Int      @default(1)
  rsvp      String   @default("Pending")                    // "Attending","Pending","Declined"
  category  String?                                          // "Family","Friends", etc.
  createdAt DateTime @default(now())

  couple    Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  @@index([coupleId])
}

// ---------- INQUIRIES (every couple→vendor message lands here, admin sees all) ----------
model Inquiry {
  id          String         @id @default(cuid())
  vendorId    String
  coupleUserId String?                                     // null = anonymous public-site inquiry
  name        String
  phone       String
  email       String?
  eventDate   DateTime?
  guests      String?                                      // free text band: "100-300"
  budget      String?
  callDiscussion String?
  notes       String?        @db.Text
  source      String?                                      // "public_site" | "couple_dashboard" | "shortlist"
  status      InquiryStatus  @default(new)
  forwardedAt DateTime?                                    // when admin forwarded to vendor
  createdAt   DateTime       @default(now())

  vendor      Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  coupleUser  User?          @relation("CoupleInquiries", fields: [coupleUserId], references: [id])
  review      Review?

  @@index([vendorId, status, createdAt])
}

// ---------- BOOKINGS & PAYMENTS ----------
model Booking {
  id         String        @id @default(cuid())
  coupleId   String
  vendorId   String
  eventDate  DateTime
  amount     Int?
  status     BookingStatus @default(pending)
  notes      String?       @db.Text
  createdAt  DateTime      @default(now())

  couple     Couple        @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  vendor     Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

model Transaction {
  id           String     @id @default(cuid())
  userId       String
  amount       Int                                         // paise
  purpose      String                                      // "featured_upgrade", "ad_credits"
  gateway      String     @default("razorpay")
  gatewayRef   String?    @unique
  status       TxnStatus  @default(initiated)
  meta         Json?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, status])
}

// ---------- ADS (Phase 4 + Grow Business Module) ----------
model AdCampaign {
  id             String           @id @default(cuid())
  vendorId       String

  // Core fields
  platform       String                                     // "facebook" | "instagram" | "google" | "whatsapp" | "featured"
  dailyBudget    Int                                        // INR
  durationDays   Int
  goal           String           @default("leads")         // "leads" | "whatsapp" | "traffic" | "social" | "featured"
  targetCity     String?
  targetAudience String?          @db.Text
  creativeCopy   String?          @db.Text
  status         AdCampaignStatus @default(draft)

  // Grow Business Package fields
  packageType    String?                                    // "whatsapp_leads" | "more_leads" | "website_sales"
  planDays       Int?                                       // 10 | 20 | 30 | 90 | 0=custom
  totalAmount    Int?                                       // Total campaign cost in INR (incl. GST)
  gstAmount      Int?                                       // GST amount in INR
  baseAmount     Int?                                       // Pre-tax base amount

  // Audience Targeting
  gender         String?          @default("all")           // "all" | "male" | "female"
  targetAreas    Json?                                      // Array of location strings
  ageMin         Int?             @default(18)
  ageMax         Int?             @default(65)
  timeSchedule   String?          @default("whole_day")     // "whole_day" | "custom"
  startTime      String?                                    // "06:00" etc.
  endTime        String?                                    // "02:00" etc.

  // Payment
  paymentMethod  String?                                    // "razorpay" | "google_pay" | "paytm" | "bhim" | "upi" | "credit_card" | "debit_card" | "net_banking"
  paymentStatus  String           @default("pending")       // "pending" | "paid" | "failed"
  paymentRef     String?                                    // External payment reference

  // Admin Management
  adminStatus    String           @default("pending")       // "pending" | "approved" | "running" | "completed" | "rejected"
  adminNotes     String?          @db.Text

  // Analytics (updated by admin)
  analyticsReach       Int        @default(0)
  analyticsImpressions Int        @default(0)
  analyticsClicks      Int        @default(0)
  analyticsLeads       Int        @default(0)
  analyticsWhatsapp    Int        @default(0)

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  vendor         Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, adminStatus])
  @@index([adminStatus, createdAt])
}

// ---------- WHATSAPP LOG ----------
model WaMessage {
  id           String    @id @default(cuid())
  userId       String?
  to           String                                        // E.164
  body         String    @db.Text
  template     String?
  campaignName String?                                       // groups messages from one admin broadcast for stats
  status       String    @default("queued")                  // queued | sending | sent | failed
  error        String?
  retryCount   Int       @default(0)                        // how many send attempts so far
  nextRetryAt  DateTime?                                     // when to next attempt (null = not scheduled)
  sentAt       DateTime?
  createdAt    DateTime  @default(now())

  user         User?     @relation("WaMessagesToUser", fields: [userId], references: [id])
  @@index([to, createdAt])
  @@index([status, nextRetryAt])                            // for retry sweep query
  @@index([campaignName])
}

// ---------- NEW AUTH SUPPORT TABLES ----------
// UserOtp: hashed OTPs for the passwordless couple login/registration flow
// (checkUser / registerAndSendOtp / verifyOtpLogin), keyed by email. Kept
// separate from OtpCode by design — both tables are in active use.
model UserOtp {
  id        String   @id @default(cuid())
  email     String
  otp       String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("user_otps")
  @@index([email])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  used      Int      @default(0) // 0 = unused, 1 = used
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("password_reset_tokens")
  @@index([token])
}

model JwtDenylist {
  id        String   @id @default(cuid())
  token     String   @unique @db.VarChar(500)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("jwt_denylist")
  @@index([token])
}

// ---------- ANALYTICS EVENTS ----------
model AnalyticsEvent {
  id          String   @id @default(cuid())
  vendorId    String
  campaignId  String?
  eventType   String                                       // "profile_visit" | "whatsapp_click" | "lead_gen"
  createdAt   DateTime @default(now())

  @@index([vendorId, eventType, createdAt])
  @@index([campaignId, eventType, createdAt])
}

// ---------- CUSTOMER REVIEWS ----------
model Review {
  id        String   @id @default(cuid())
  vendorId  String
  inquiryId String?  @unique
  name      String
  rating    Float
  text      String   @db.Text
  createdAt DateTime @default(now())

  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  inquiry   Inquiry? @relation(fields: [inquiryId], references: [id], onDelete: SetNull)

  @@index([vendorId, createdAt])
}

// ---------- ADMIN BULK EMAIL BROADCASTS ----------
model EmailCampaign {
  id               String   @id @default(cuid())
  name             String
  segment          String                                       // "all" | "vendors" | "couples" | JSON rules
  subject          String
  previewText      String?  @map("preview_text")
  body             String   @db.Text
  audienceRules    String?  @db.Text                             @map("audience_rules")
  customEmails     String?  @db.Text                             @map("custom_emails")
  failedRecipients  String?  @db.Text                             @map("failed_recipients")
  totalRecipients  Int      @default(0) @map("total_recipients")
  sentCount        Int      @default(0) @map("sent_count")
  failedCount      Int      @default(0) @map("failed_count")
  deliveredCount   Int      @default(0) @map("delivered_count")
  status           String   @default("draft")                   // "draft" | "scheduled" | "queued" | "sending" | "completed" | "failed" | "partially_failed"
  scheduledAt      DateTime? @map("scheduled_at")
  scheduleType     String   @default("once") @map("schedule_type") // "once" | "daily" | "weekly" | "monthly"
  scheduleTime     String?  @map("schedule_time")
  daysOfWeek       String?  @db.Text @map("days_of_week")
  dayOfMonth       Int?     @map("day_of_month")
  lastRunAt        DateTime? @map("last_run_at")
  nextRunAt        DateTime? @map("next_run_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("email_campaigns")
  @@index([createdAt])
  @@index([status, nextRunAt])
}

model EmailTemplate {
  id          String   @id @default(cuid())
  name        String
  subject     String
  previewText String?  @map("preview_text")
  body        String   @db.Text
  category    String?  @default("general")
  status      String   @default("active")
  isSystem    Boolean  @default(false)      @map("is_system")
  createdAt   DateTime @default(now())      @map("created_at")
  updatedAt   DateTime @updatedAt           @map("updated_at")

  @@map("email_templates")
}

// ---------- SEO BLOG ARTICLES ----------
model Blog {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  metaDescription String    @map("meta_description")
  content         String    @db.Text
  status          String    @default("draft")                    // "draft" | "published"
  views           Int       @default(0)
  likes           Int       @default(0)
  publishedAt     DateTime? @map("published_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("blogs")
  @@index([status, publishedAt])
}

// ---------- DATA INTELLIGENCE & IMPORT HISTORY ----------
model ImportHistory {
  id             String   @id @default(cuid())
  importBatchId  String   @unique @map("import_batch_id")
  fileName       String   @map("file_name")
  source         String?  @default("CSV/XLSX Importer")
  totalRows      Int      @map("total_rows")
  importedCount  Int      @map("imported_count")
  updatedCount   Int      @default(0) @map("updated_count")
  skippedCount   Int      @default(0) @map("skipped_count")
  failedCount    Int      @default(0) @map("failed_count")
  columnMap      Json?    @map("column_map")
  errorLog       Json?    @map("error_log")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("import_histories")
  @@index([createdAt])
}

model ImportMappingPreference {
  id           String   @id @default(cuid())
  fingerprint  String   @unique
  headers      Json
  columnMap    Json     @map("column_map")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("import_mapping_preferences")
}

// ---------- COUNTRY, CITY, REGION HIERARCHY ----------
model Country {
  id                         String   @id @default(cuid())
  name                       String   @unique
  slug                       String   @unique
  code                       String   @unique                            // ISO 3166-1 alpha-2 e.g. "IN", "AE", "GB", "US", "CA", "AU"
  isoAlpha3                  String?                                     // e.g. "IND", "ARE", "GBR", "USA", "CAN", "AUS"
  currency                   String   @default("INR")                    // e.g. "INR", "AED", "GBP", "USD", "CAD", "AUD"
  currencySymbol             String   @default("₹")                      // e.g. "₹", "AED", "£", "$", "CA$", "A$"
  phoneCode                  String   @default("+91")                    // e.g. "+91", "+971", "+44", "+1", "+1", "+61"
  flag                       String   @default("🇮🇳")
  timezone                   String   @default("Asia/Kolkata")
  defaultLanguage            String   @default("en")                     @map("default_language")
  status                     String   @default("active")                 // "active" | "inactive" | "draft"
  readinessScore             Int      @default(100)                      @map("readiness_score")
  isMarketplaceEnabled       Boolean  @default(true)                     @map("is_marketplace_enabled")
  isVendorOnboardingEnabled  Boolean  @default(true)                     @map("is_vendor_onboarding_enabled")
  isCoupleEnquiriesEnabled   Boolean  @default(true)                     @map("is_couple_enquiries_enabled")
  displayOrder               Int      @default(0)
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  cities         City[]
  regions        Region[]
  vendors        Vendor[]

  @@map("countries")
  @@index([status, displayOrder])
}

model City {
  id           String   @id @default(cuid())
  countryId    String   @map("country_id")
  name         String
  slug         String   @unique
  state        String?
  timezone     String?
  lat          Float?
  lng          Float?
  image        String?  @db.VarChar(500)
  description  String?  @db.Text
  status       String   @default("active")                   // "active" | "inactive"
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  country      Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  regions      Region[]
  vendors      Vendor[]

  @@map("cities")
  @@index([countryId, status])
}

model Region {
  id        String   @id @default(cuid())
  countryId String?  @map("country_id")
  cityId    String?  @map("city_id")
  name      String
  slug      String
  status    String   @default("active")                     // "active" | "inactive"
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  country   Country? @relation(fields: [countryId], references: [id], onDelete: Cascade)
  city      City?    @relation(fields: [cityId], references: [id], onDelete: Cascade)
  vendors   Vendor[]

  @@map("regions")
  @@index([countryId, status])
  @@index([cityId, status])
}



